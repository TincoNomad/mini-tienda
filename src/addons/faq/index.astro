---
import { faqs } from '../../data/site';
---

<section class="faq-section" aria-labelledby="faq-title">
	<img
		class="faq-flower"
		src="/images/flawer_decorator.webp"
		alt=""
		aria-hidden="true"
		loading="lazy"
	/>
	<div class="wrap section">
		<h2 id="faq-title" class="neon neon-md grad-faq" data-text="Preguntas frecuentes">
			Preguntas frecuentes
		</h2>
		<div class="faq-list">
			{
				faqs.map((faq) => (
					<details class="faq-item">
						<summary>{faq.question}</summary>
						<p>{faq.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.faq-section {
		position: relative;
		z-index: 1;
		overflow: clip;
	}

	.faq-flower {
		position: absolute;
		right: 0;
		bottom: clamp(24px, 3vw, 48px);
		z-index: -1;
		width: clamp(80px, 22vw, 260px);
		height: auto;
		pointer-events: none;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
		max-width: 720px;
		margin: 0 auto;
	}

	.faq-item {
		border: 3px solid var(--text);
		background: var(--card);
		padding: 0 16px;
	}

	.faq-item summary {
		cursor: pointer;
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
		font-weight: 700;
		padding: 14px 28px;
		list-style: none;
		text-align: center;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::after {
		content: '+';
		font-size: 22px;
		line-height: 1;
		position: absolute;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
	}

	.faq-item[open] summary::after {
		content: '−';
	}

	.faq-item p {
		color: var(--muted);
		line-height: 1.5;
		margin: 0;
		padding: 0 0 16px;
		text-align: center;
	}
</style>
