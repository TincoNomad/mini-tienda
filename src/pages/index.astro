---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import Catalogo from '../components/Catalogo.vue';
import ComoPedir from '../components/ComoPedir.astro';
import Addons from '../components/Addons.astro';
import Footer from '../components/Footer.astro';
import { productos, categorias } from '../data/site';
---

<Base>
	<Header />
	<section class="hero wrap">
		<Hero />
		<Bento />
		<a class="hero-scroll" href="#catalogo">↓ Ver catálogo</a>
	</section>
	<Catalogo productos={productos} categorias={categorias} client:load />
	<ComoPedir />
	<Addons />
	<Footer />
</Base>
