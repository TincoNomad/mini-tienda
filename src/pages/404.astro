---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { categorias } from '../data/site';
---

<Base title="Página no encontrada · Marketplace de audífonos">
	<Header />
	<section
		class="wrap"
		style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; padding-top: 56px;"
	>
		<h1 class="neon" style="font-size: clamp(96px, 16vw, 180px);">404</h1>
		<p style="font-size: 22px; margin: 0;">Esta página no existe. Busca lo que necesitas:</p>

		<div style="width: 100%; max-width: 560px;">
			<form action="/#catalogo" method="get" style="display: flex; gap: 8px; flex-wrap: wrap;">
				<label for="q" class="visually-hidden">Buscar audífonos</label>
				<input
					id="q"
					name="q"
					class="search-input"
					type="search"
					placeholder="Buscar audífonos..."
				/>
				<button class="btn" type="submit" style="cursor: pointer;">Buscar</button>
			</form>
		</div>

		<div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;">
			{
				categorias.map((cat) => (
					<a
						class="chip chip-link"
						href={`/?cat=${cat.slug}#catalogo`}
					>
						{cat.nombre}
					</a>
				))
			}
		</div>

		<a class="btn" href="/">Volver al inicio</a>
	</section>
	<Footer />
</Base>
