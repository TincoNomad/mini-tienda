---
import { categorias } from '../data/site';
---

<div class="bento">
	{
		categorias.map((cat, i) => (
			<a
				href={`/?cat=${cat.slug}#catalogo`}
				class={i === 0 ? 'bento-big' : ''}
				style={`background: ${cat.color}`}
			>
				{cat.nombre}
				<small>
					{cat.modelos} modelos {i === 0 ? ' · [foto]' : ''}
				</small>
			</a>
		))
	}
</div>
