---
---

<div class="hero-copy">
	<p class="hero-eyebrow">Envíos a todo el Perú · Pedidos por WhatsApp</p>
	<h1 class="neon hero-title">Audífonos</h1>
	<p class="hero-description">
		Para trabajar, entrenar y viajar. Compara modelos y pídelos directo por WhatsApp.
	</p>
	<div class="hero-actions">
		<a class="btn hero-cta" href="#catalogo">Elegir mis audífonos</a>
	</div>
	<form class="hero-search" action="#catalogo" method="get">
		<label for="q" class="visually-hidden">Buscar audífonos</label>
		<input
			id="q"
			name="q"
			class="search-input"
			type="search"
			placeholder="Buscar audífonos..."
		/>
		<button class="btn btn-secondary" type="submit" style="cursor: pointer;">Buscar</button>
	</form>
	<p class="hero-popular">Populares: Inalámbricos · Gaming · Bluetooth</p>
</div>

<script>
	function syncSearchInput() {
		const input = document.getElementById('q') as HTMLInputElement | null;
		if (!input) return;

		const params = new URLSearchParams(window.location.search);
		input.value = params.get('q') ?? '';
	}

	syncSearchInput();

	window.addEventListener('popstate', syncSearchInput);

	document.addEventListener('search', (event) => {
		const target = event.target as HTMLInputElement | null;
		if (!target || target.id !== 'q') return;
		if (target.value === '') {
			window.location.href = '/#catalogo';
		}
	});
</script>
