---
import Bento from './Bento.astro';
---

<section class="wrap two" style="padding-top: 32px; padding-bottom: 24px;">
	<div style="display: flex; flex-direction: column; gap: 24px; justify-content: center;">
		<h1 class="neon" style="font-size: clamp(64px, 10vw, 120px);">Audífonos</h1>
		<p style="font-size: 22px; margin: 0; max-width: 480px;">
			Para trabajar, entrenar y viajar. Compara modelos y pídelos directo por WhatsApp.
		</p>
		<form action="#catalogo" method="get" style="display: flex; gap: 8px; flex-wrap: wrap;">
			<label for="q" class="visually-hidden">Buscar audífonos</label>
			<input
				id="q"
				name="q"
				class="search-input"
				type="search"
				placeholder="Buscar audífonos..."
			/>
			<button class="btn" type="submit" style="cursor: pointer;">Buscar</button>
		</form>
		<p style="margin: 0; font-size: 15px; color: var(--muted);">
			Populares: Inalámbricos · Gaming · Bluetooth
		</p>
	</div>
	<Bento />
</section>
