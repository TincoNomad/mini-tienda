---
---

<section class="como-pedir" style="padding-top: 40px;">
	<img
		class="como-pedir-flower"
		src="/images/flawer_decorator.webp"
		alt=""
		aria-hidden="true"
		loading="lazy"
	/>
	<div class="wrap">
		<h2 class="neon neon-md grad-como-pedir" data-text="Cómo pedir">Cómo pedir</h2>
		<div class="steps-inner">
			<div class="steps-grid">
				<div class="card como-pedir-card">
					<strong style="font-size: 28px;">1</strong>
					Elige tu modelo
				</div>
				<div class="card como-pedir-card">
					<strong style="font-size: 28px;">2</strong>
					Escríbenos por WhatsApp, el mensaje ya lleva el producto
				</div>
				<div class="card como-pedir-card">
					<strong style="font-size: 28px;">3</strong>
					Coordina pago y entrega
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.como-pedir {
		--flower-w: clamp(80px, min(22vw, 35vh), 260px);
		position: relative;
		z-index: 1;
		overflow: clip;
		padding-bottom: calc(var(--flower-w) * 0.6);
	}

	/* 0.08: margen transparente del webp (4,8%) + sobra por rotar 25° (9,15%),
	   deja la flor pintada tocando el borde izquierdo del viewport */
	.como-pedir-flower {
		position: absolute;
		left: calc(var(--flower-w) * 0.08);
		top: 50%;
		z-index: -1;
		width: var(--flower-w);
		height: auto;
		pointer-events: none;
		transform: translateY(-50%) rotate(-25deg);
	}

	.steps-inner {
		max-width: 900px;
		margin: 0 auto;
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.como-pedir-card {
		align-items: center;
		text-align: center;
	}

	@media (max-width: 900px) {
		.steps-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
