---
import { siteConfig, waMessages } from '../data/site';

interface Props {
	texto?: string;
	clase?: string;
	message?: string;
}

const {
	texto = siteConfig.whatsappLabel,
	clase = 'btn',
	message = waMessages.vendedor,
} = Astro.props;
---

<a class={clase} href="#" target="_blank" rel="noopener noreferrer" data-wa data-wa-msg={message}>
	{texto}
</a>
