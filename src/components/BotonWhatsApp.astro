---
import { siteConfig, waLink, waMessages } from '../data/site';

interface Props {
	texto?: string;
	clase?: string;
	message?: string;
}

const {
	texto = siteConfig.whatsappLabel,
	clase = 'btn',
	message = waMessages.vendedor,
} = Astro.props;

const href = waLink(message);
---

<a class={clase} href={href} target="_blank" rel="noopener noreferrer">{texto}</a>
