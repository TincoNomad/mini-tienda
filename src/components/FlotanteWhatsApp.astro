---
import { siteConfig, waLink, waMessages } from '../data/site';

const href = waLink(waMessages.vendedor);
---

<a
	class="wa-flotante"
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={siteConfig.whatsappLabel}
>
	<span class="wa-flotante-label">{siteConfig.whatsappLabel}</span>
	<span class="wa-flotante-icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="currentColor">
			<path
				d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
			></path>
		</svg>
	</span>
	<span class="wa-flotante-mobile">WhatsApp</span>
</a>

<script>
	const hero = document.querySelector('.hero');
	const flotante = document.querySelector('.wa-flotante');

	if (hero && flotante) {
		const observer = new IntersectionObserver(
			([entry]) => {
				flotante.classList.toggle('is-visible', !entry.isIntersecting);
			},
			{ threshold: 0 },
		);

		observer.observe(hero);
	}
</script>

<style>
	.wa-flotante {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 50;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border: 3px solid var(--text);
		border-radius: 50%;
		background: var(--accent-hover);
		color: var(--text);
		box-shadow: 4px 4px 0 var(--text);
		text-decoration: none;
		opacity: 0;
		visibility: hidden;
		transform: translateY(12px);
		transition:
			opacity 0.2s,
			transform 0.2s,
			visibility 0.2s;
	}

	.wa-flotante.is-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.wa-flotante:hover {
		background: var(--accent);
	}

	.wa-flotante-icon {
		display: flex;
	}

	.wa-flotante-icon svg {
		width: 26px;
		height: 26px;
	}

	.wa-flotante-label {
		position: absolute;
		right: calc(100% + 12px);
		top: 50%;
		transform: translateY(-50%);
		background: var(--text);
		color: var(--bg);
		padding: 8px 12px;
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s;
	}

	.wa-flotante:hover .wa-flotante-label,
	.wa-flotante:focus-visible .wa-flotante-label {
		opacity: 1;
	}

	.wa-flotante-mobile {
		display: none;
	}

	@media (max-width: 600px) {
		.wa-flotante {
			width: auto;
			height: 56px;
			gap: 8px;
			padding: 0 16px;
			border-radius: 999px;
		}

		.wa-flotante-label {
			display: none;
		}

		.wa-flotante-mobile {
			display: inline;
			font-size: 15px;
			font-weight: 700;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wa-flotante,
		.wa-flotante-label {
			transition: none;
		}
	}
</style>
